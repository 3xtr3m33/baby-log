# Ключи для сборки на GitHub Pages.
# publishable-ключ по своей природе уезжает в браузер вместе с бандлом — доступ к данным
# закрывает не он, а вход по коду приглашения и RLS-политики в Supabase (supabase/schema.sql).
# Ключ service_role здесь оказаться не должен никогда.
VITE_SUPABASE_URL=https://mcwvllivgqwofxydvyls.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xN0JPSw_znG0Qltgxy7aWA_CJJe3kS7

# Пока вход по почте не поднят — открытый локальный режим: без логина,
# записи хранятся на устройстве. Поставить 0, чтобы вернуть вход и синхронизацию.
VITE_LOCAL_ONLY=1
